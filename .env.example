# Copy to .env (gitignored) and adjust before running `docker compose up`.
# .env is read by docker-compose.yml -- nothing here is a real secret.

# JSON {key: role} map, same format as the README's API auth section.
# Roles: customer, support_agent, reviewer.
AGENTOPS_API_KEYS={"cust-key":"customer","agent-key":"support_agent","reviewer-key":"reviewer"}

# Baked into the dashboard's JS bundle at build time (Vite env vars always
# are). VITE_API_KEY must be one of the reviewer-role keys from
# AGENTOPS_API_KEYS above so the Approvals page works.
VITE_API_URL=http://localhost:8000
VITE_API_KEY=reviewer-key

# Grafana admin login (http://localhost:3000). Change this before exposing
# the stack beyond your own machine.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
