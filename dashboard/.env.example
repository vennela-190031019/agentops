# Copy to .env.local (gitignored) and adjust for your environment.
#
# VITE_API_KEY must be a reviewer-role key: the Approvals page needs
# "reviewer" to list/resolve approvals, and a reviewer key also has read
# access to /traces and /evals, so one key covers every page in this
# dashboard. These match the API's built-in dev-key fallback used when the
# backend's AGENTOPS_API_KEYS env var is unset (see README.md) -- replace
# with a real key from your AGENTOPS_API_KEYS map in any shared environment.
VITE_API_URL=http://localhost:8000
VITE_API_KEY=dev-reviewer-key
